GUI_HOST_PORT=80
ORCHESTRATOR_HOST_PORT=8002

# VITE_ORCHESTRATOR_API_ENDPOINT=http://localhost:8002/chat
VITE_ORCHESTRATOR_API_ENDPOINT=chat
VITE_BUILD_SHA=unknown
VITE_DEPLOY_ENV=Local

MODEL_CHAT=gemma4:31b
MODEL_SLM=llama3.1:8b

RAG_API_URL=http://rag_cisuc:8001/query
CHROMA_HOST=chromadb
CHROMA_PORT=8000
RAG_TOP_K=15

# Orchestrator -> RAG calls
# Per-call timeout in seconds (scaled by the worker count when queries run in parallel).
RAG_REQUEST_TIMEOUT=30
# 1 = sequential (original behaviour). >1 = run the full-question and keyword queries in parallel.
ORCH_RAG_MAX_PARALLEL=1

# OpenAI models
# MODEL_CHAT=gpt-5.4-mini
# MODEL_SLM=gpt-4.1-nano

RAG_MAX_RETRYS=3
RAG_RETRY_DELAY=3

RAG_IMAGE=cisuc-rag:local
ORCHESTRATOR_IMAGE=cisuc-orchestrator:local
GUI_IMAGE=cisuc-gui:local

# EU funding calls (RAG_CALLS over the external-sources store, Postgres + pgvector).
# CALLS_SOURCE=off keeps the CISUC-only behaviour. Passwords (EXTSRC_DB_PASSWORD,
# EXTSRC_DB_READER_PASSWORD) are NOT here: secrets/chatbot.env locally, GitHub secrets in CI.
CALLS_SOURCE=on
CALLS_API_URL=http://rag_calls:8003/query
CALLS_TOP_K=8
# Retrieval / reranking (RAG_CALLS) — same knobs and defaults as RAG_CISUC's RAG_* settings.
CALLS_RERANKER_MODEL=unicamp-dl/mMiniLM-L6-v2-mmarco-v2
CALLS_RETRIEVER_K_LEXICAL=20
CALLS_RETRIEVER_K_VECTOR=20
CALLS_RRF_WEIGHT_LEXICAL=0.6
CALLS_RRF_WEIGHT_VECTOR=0.4
CALLS_POOL_MULTIPLIER=2
CALLS_POOL_MIN_SIZE=20
CALLS_CPUS=4
CALLS_QUERY_CACHE_SIZE=512
CALLS_DETAILED=3
CALLS_DETAILED_MAX_CHARS=4000
CALLS_IMAGE=cisuc-calls:local
EXTSRC_DB_IMAGE=pgvector/pgvector:pg16
EXTSRC_DB_NAME=external_sources
# Loader/owner login (migrations, snapshots) and the chatbot's read-only login.
EXTSRC_DB_USER=extsrc_loader
EXTSRC_DB_READER_USER=extsrc_chatbot
EXTSRC_DB_READER_STATEMENT_TIMEOUT_MS=5000
EXTSRC_DB_LOAD_TIMEOUT_MS=600000
